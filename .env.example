APP_NAME=iNDECS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Required only when creating the local pilot officer during the first database seed.
INDECS_DEMO_PASSWORD=

INDECS_STAFF_AUTH_DRIVER=mbsp
MBSP_STAFF_API_URL=
MBSP_STAFF_API_BASIC_USERNAME=
MBSP_STAFF_API_BASIC_PASSWORD=
MBSP_STAFF_API_KEY=
MBSP_STAFF_API_TOKEN=
MBSP_STAFF_API_PASSWORD_MODE=md5
MBSP_STAFF_API_CA_BUNDLE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/portal/google/callback

APP_LOCALE=ms
DISPLAY_TIMEZONE=Asia/Kuala_Lumpur
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev database: native PostgreSQL 18 with PostGIS and pg_trgm on port 5434.
# The single `iNDECS` database hosts iNDECS (`public`, `core`), AIRS (`airs`),
# and MIDR (`catalogue`, `core`, `application`, `publish`), with `indecs_test`
# used for isolated automated test runs.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=iNDECS
DB_USERNAME=indecs
DB_PASSWORD=indecs_local_dev

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@indecs.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Malware scanner must report clean before new Bangunan uploads are stored.
INDECS_DOCUMENT_SCANNER_BINARY=clamscan
INDECS_DOCUMENT_SCANNER_DATABASE=
INDECS_DOCUMENT_SCANNER_CERTIFICATES=

# GIS (eOSC+ meeting map). ogr2ogr ships with PostgreSQL on Windows; ArcGIS queries are anonymous unless a login is needed.
GIS_OGR2OGR=
# Queue connection gis (layer replication): retry_after must exceed the 3600 s job timeout.
GIS_QUEUE_RETRY_AFTER=3900
ARCGIS_PORTAL_URL=https://spgis.mbsp.gov.my/portal
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
ORTHOPHOTO_TILE_URL=

# AIRS backend connector. Public payment/submission gates remain enforced.
AIRS_ENABLED=false
AIRS_SERVICE_URL=
AIRS_SERVICE_TOKEN=

# AMIRA conversation (ADR-364). Server-side only. Generate the token with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# and set the same value as the "indecs" client token in the AMIRA backend's AMIRA_CLIENT_TOKENS.
AMIRA_ENABLED=false
AMIRA_SERVICE_URL=http://127.0.0.1:8770
AMIRA_SERVICE_TOKEN=
AMIRA_DAILY_LIMIT=30
AMIRA_RETENTION_MONTHS=12
